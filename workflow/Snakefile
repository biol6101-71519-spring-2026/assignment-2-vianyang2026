configfile: 'config/config.yaml'

rule all: # tells Snakemake what the final outputs files are
    input: # list of all the final output files that we want to generate
        expand("results/qc/fastqc/{sample}_R1_fastqc.html", sample=config["samples"]), # generates a list of all the fastqc html files for R1 reads based on the sample names in the config file
        expand("results/qc/fastqc/{sample}_R2_fastqc.html", sample=config["samples"]), # generates a list of all the fastqc html files for R2 reads based on the sample names in the config file
        "results/qc/multiqc_report.html", # the final multiqc report that summarizes all the fastqc results
        "results/bowtie2/index/ecoli_K12.1.bt2",  # the bowtie2 index files for the reference genome, we can list them individually or use a pattern like "results/bowtie2/index/ecoli_K12.*.bt2"
        expand("results/mapped/{sample}.sorted.bam", sample=config["samples"]), # generates a list of all the sorted bam files for each sample based on the sample names in the config file
        expand("results/mapped/{sample}.sorted.bam.bai", sample=config["samples"]), # generates a list of all the bam index files for each sample based on the sample names in the config file
        expand("results/stats/{sample}.flagstat.txt", sample=config["samples"]) # generates a list of all the flagstat txt files for the sample
rule fastqc: # rule name, for thw qc step
    input:  # the input files for this rule, these are the raw fastq files requred by fastqc program to run the quality control analysis,  
        "data/fastq/{sample}_R1.fastq.gz",
        "data/fastq/{sample}_R2.fastq.gz"
    output:  # the output files for this rule, specifically the html reports generated by fastqc for each sample and read pair. specifies the directory and the file name.
        "results/qc/fastqc/{sample}_R1_fastqc.html",
        "results/qc/fastqc/{sample}_R2_fastqc.html"
    log: # the log file for this rule, captures standard output and standard error from the fastqc command.
        "logs/fastqc/{sample}.log"
    shell:   # is the executing command for the rule, specifically code needed to run the fastqc program on the input files and generate the output files, while also redirecting the output and error messages to the log file.
        "fastqc {input} -o results/qc/fastqc > {log} 2>&1"

rule multiqc: # rule name for the multiqc step, which aggregates the results from fastqc into a single report, it takes the fastqc html files as input and produces a multiqc report as output.
    input:
        expand("results/qc/fastqc/{sample}_R1_fastqc.html", sample=config["samples"]),
        expand("results/qc/fastqc/{sample}_R2_fastqc.html", sample=config["samples"])
    output:
        "results/qc/multiqc_report.html"
    log:
        "logs/multiqc/multiqc.log"
    shell:
        "multiqc results/qc/fastqc -o results/qc > {log} 2>&1" 

rule bowtie2_build: # rule name for building the bowtie2 index, which is necessary for mapping the reads to the reference genome. It takes the reference genome fasta file as input and produces multiple index files as output.
    input:
        "data/reference/ecoli_K12.fa"
    output:
        "results/bowtie2/index/ecoli_K12.1.bt2",
        "results/bowtie2/index/ecoli_K12.2.bt2",
        "results/bowtie2/index/ecoli_K12.3.bt2",
        "results/bowtie2/index/ecoli_K12.4.bt2",
        "results/bowtie2/index/ecoli_K12.rev.1.bt2",
        "results/bowtie2/index/ecoli_K12.rev.2.bt2"
    log:
        "logs/bowtie2-build/ecoli_K12.log"
    shell:
        "bowtie2-build {input} results/bowtie2/index/ecoli_K12 > {log} 2>&1"

rule bowtie2_map: # rule name for mapping the reads to the reference genome using bowtie2, it takes the bowtie2 index files and the raw fastq files as input and produces sam files as output, which contain the alignment information of the reads to the reference genome.
    input:
        index="results/bowtie2/index/ecoli_K12.1.bt2",
        r1="data/fastq/{sample}_R1.fastq.gz",
        r2="data/fastq/{sample}_R2.fastq.gz"
    output:
        "results/bowtie2/mapping/{sample}.sam" 
    log:
        "logs/bowtie2-mapping/{sample}.log"
    threads: config["bowtie2"]["threads"]
    params:
        sensitivity=config["bowtie2"]["sensitivity"]
    shell:
        "bowtie2 -x results/bowtie2/index/ecoli_K12 "
        "{params.sensitivity} "
        "-1 {input.r1} -2 {input.r2} "
        "-S {output} -p {threads} > {log} 2>&1"

rule sam_to_bam: # rule name for converting sam files to bam files using samtools, it takes the sam files generated by the bowtie2 mapping step as input and produces bam files as output.
    input:
        "results/bowtie2/mapping/{sample}.sam"
    output:
        "results/mapped/{sample}.bam"
    log:
        "logs/sam_to_bam/{sample}.log"
    shell:
        "samtools view -bS {input} > {output} 2> {log}"

rule sort_bam: # rule name for sorting bam files using samtools, it takes the bam files generated by the sam_to_bam step as input and produces sorted bam files as output, which are necessary for indexing and downstream analysis.
    input:
        "results/mapped/{sample}.bam"
    output:
        "results/mapped/{sample}.sorted.bam"  
    log:
        "logs/sort_bam/{sample}.log"
    threads: 4
    shell:
        "samtools sort -@ {threads} {input} -o {output} 2> {log}"

rule index_bam: # rule name for indexing bam files using samtools, it takes the sorted bam files generated by the sort_bam step as input and produces bam index files as output, which are necessary for efficient access to the alignment data in the bam files.
    input:
        "results/mapped/{sample}.sorted.bam"
    output:
        "results/mapped/{sample}.sorted.bam.bai"
    log:
        "logs/index_bam/{sample}.log"
    shell:
        "samtools index {input} 2> {log}"

rule flagstat: # rule name for generating flagstat statistics using samtools, it takes the sorted bam files generated by the sort_bam step as input and produces text files containing the flagstat statistics as output, which provide information about the quality and characteristics of the alignments in the bam files.
    input:
        "results/mapped/{sample}.sorted.bam"
    output:
        "results/stats/{sample}.flagstat.txt"
    log:
        "logs/flagstat/{sample}.log"
    shell:
        "samtools flagstat {input} > {output} 2> {log}"